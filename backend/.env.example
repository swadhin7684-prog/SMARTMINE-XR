# Server port
PORT=5000

# MongoDB connection string
# Local:   mongodb://localhost:27017/smartmine_xr
# Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/smartmine_xr
MONGODB_URI=mongodb://localhost:27017/smartmine_xr

# JWT secret — use a strong random string in production
JWT_SECRET=CHANGE_ME_use_a_strong_random_secret

# Allowed CORS origins (comma-separated for multiple)
# Example: http://localhost:5173,https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173

# Node environment
NODE_ENV=development
