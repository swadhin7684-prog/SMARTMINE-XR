# SmartMine XR Frontend Configuration Template
# In development, leave VITE_API_URL blank so requests to /api are proxied to localhost:5000 by Vite
# In production (e.g. deployed on Vercel), set this to your backend server URL (e.g., https://smartmine-api.onrender.com)
VITE_API_URL=

# Firebase Client Configuration (smartminexr)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
